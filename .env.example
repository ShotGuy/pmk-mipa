# Database Connection (Supabase PostgreSQL)
# Example: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"

# Direct connection for migrations
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# NextAuth / Auth.js Secret (Generate via: openssl rand -base64 32)
AUTH_SECRET="your-32-byte-base64-secret"

# Optional: Default password for database seeding (required in production seed)
SEED_DEFAULT_PASSWORD=""
